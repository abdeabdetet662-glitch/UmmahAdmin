<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#FCE38A"
                        android:centerColor="#D4AF37"
                        android:endColor="#8B6914"/>
                </shape>
            </item>
            <item android:top="2dp" android:bottom="30dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#60FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
